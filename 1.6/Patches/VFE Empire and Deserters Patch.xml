<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Vanilla Factions Expanded - Empire</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationAdd">
					<xpath>Defs/FactionDef[defName="VFEE_Deserters"]/xenotypeSet/xenotypeChances</xpath>
					<value>
						<OL_SerenBase MayRequire="Ludeon.RimWorld.Biotech">0.1</OL_SerenBase>
					</value>
				</li>
				<li Class="PatchOperationAdd">
					<xpath>Defs/FactionDef[defName="VFEE_Deserters"]/pawnGroupMakers/li[1]/options</xpath>
					<value>
						<SerenDeserter>1</SerenDeserter>
					</value>
				</li>
				<li Class="PatchOperationAdd">
					<xpath>Defs/FactionDef[defName="VFEE_Deserters"]/pawnGroupMakers/li[2]/options</xpath>
					<value>
						<SerenDeserter>1</SerenDeserter>
					</value>
				</li>
			</operations>
		</match>
	</Operation>

</Patch>