<?xml version="1.0" encoding="utf-8" ?>
<Patch>

	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Way Better Romance</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationAddModExtension">
					<xpath>Defs/AlienRace.ThingDef_AlienRace[defName="Seren"]</xpath>
					<value>
						<li Class="BetterRomance.SexualityChances">
							<sexual>
								<hetero>30</hetero>
								<homo>15</homo>
								<bi>50</bi>
								<none>5</none>
							</sexual>
							
							<asexual>
								<hetero>20</hetero>
								<homo>20</homo>
								<bi>50</bi>
								<none>10</none>
							</asexual>
						</li>
					</value>
				</li>
				<li Class ="PatchOperationAddModExtension">
					<xpath>Defs/AlienRace.ThingDef_AlienRace[defName="Seren"]</xpath>
					<value>
						<li Class="BetterRomance.CasualSexSettings">
							<caresAboutCheating>True</caresAboutCheating>
							<willDoHookup>True</willDoHookup>
							<canDoOrderedHookup>True</canDoOrderedHookup>
							<hookupRate>100</hookupRate> <!-- Apparently affected by the low/high libido genes and the loving intervals, so not really something I need to adjust here -->
							<hookupTriggers>
								<minOpinion>30</minOpinion>
							</hookupTriggers>
							<orderedHookupTriggers>
								<minOpinion>15</minOpinion>
								<forBreedingOnly>False</forBreedingOnly>
							</orderedHookupTriggers>
						</li>
					</value>
				</li>
				<li Class="PatchOperationAddModExtension">
					<xpath>Defs/AlienRace.ThingDef_AlienRace[defName="Seren"]</xpath>
					<value>
						<li Class="BetterRomance.RegularSexSettings">
							<minAgeForSex>20</minAgeForSex>
							<maxAgeForSex>250</maxAgeForSex>
							<maxAgeGap>100</maxAgeGap>
							<declineAtAge>175</declineAtAge>
						</li>
					</value>
				</li>
				<li Class="PatchOperationAddModExtension">
					<xpath>Defs/AlienRace.ThingDef_AlienRace[defName="Seren"]</xpath>
					<value>
						<li Class="BetterRomance.RelationSettings">
							<spousesAllowed>True</spousesAllowed>
							<childrenAllowed>True</childrenAllowed>
							<maxFemaleAgeToHaveChildren>200</maxFemaleAgeToHaveChildren>
							<maxMaleAgeToHaveChildren>250</maxMaleAgeToHaveChildren>
							<spousesAllowed>True</spousesAllowed>
							<minFemaleAgeToHaveChildren>20</minFemaleAgeToHaveChildren>
							<usualFemaleAgeToHaveChildren>75</usualFemaleAgeToHaveChildren>
							<minMaleAgeToHaveChildren>20</minMaleAgeToHaveChildren>
							<usualMaleAgeToHaveChildren>75</usualMaleAgeToHaveChildren>
							<maxChildrenDesired>5</maxChildrenDesired>
							<minOpinionRomance>30</minOpinionRomance>
						</li>
					</value>
				</li>
			</operations>
		</match>
	</Operation>

</Patch>